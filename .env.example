# Plenty configuration. Copy to .env and fill in. Every value here is a DUMMY placeholder.
# With the defaults below the whole demo runs locally with no AWS account at all.
# On AWS, prefer an IAM role (EC2 instance profile / ECS task role / App Runner instance role)
# over access keys. Leave the key lines commented out when a role is attached.

# --- Agent -------------------------------------------------------------------
# mock    = deterministic planner over the same 10 tools (no AWS needed)
# bedrock = Strands agent on Claude via Amazon Bedrock
AGENT_MODE=mock
AWS_REGION=me-central-1
# Region where Bedrock is called. Claude in the Middle East runs through global cross-Region inference.
BEDROCK_REGION=me-central-1
# Inference profile or model ID enabled in YOUR account. Check the Bedrock console > Model access.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# If Bedrock errors before the agent's first tool call, run the mock planner instead (keeps a live demo alive).
BEDROCK_FALLBACK=true

# Only if you are NOT using an IAM role (dummy values, replace locally, never commit):
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Storage -----------------------------------------------------------------
# memory = in-process (single instance), dynamodb = the table from infra/template.yaml
STORE=memory
DDB_TABLE=plenty-demo

# --- Routing -----------------------------------------------------------------
# haversine = straight-line estimate x road factor, location = Amazon Location Service Routes (geo-routes)
ROUTING=haversine
AVG_SPEED_KMH=32
ROAD_FACTOR=1.35
STOP_SERVICE_MIN=5
MAX_DRIVE_MIN=35

# --- Notifications -----------------------------------------------------------
# inapp = the phone screens only, sns = also publish every message to an SNS topic
NOTIFY=inapp
SNS_TOPIC_ARN=arn:aws:sns:me-central-1:000000000000:plenty-notifications

# --- Photos ------------------------------------------------------------------
# Leave empty to keep photos in memory. Set to the bucket from infra/template.yaml to upload to S3.
PHOTO_BUCKET=

# --- Food safety and demo timing -------------------------------------------------
# Minutes before the safe-until time by which food must be delivered.
SERVE_BUFFER_MIN=60
# How long offers wait for an answer before counting as declined.
OFFER_TIMEOUT_SECONDS=60
# How fast the simulated partners (everyone except the judge's shelter) answer.
SIM_RESPONSE_SECONDS=3
# Pins the Dubai clock at this time on start and on every reset, so "cooked at 6" always works. Empty = real time.
DEMO_CLOCK=19:40
TIMEZONE=Asia/Dubai

# --- Impact ------------------------------------------------------------------
KG_PER_PORTION=0.35
CO2E_PER_KG_FOOD=2.5
CO2E_SOURCE=placeholder factor: replace with a cited source before the pitch

# Public address of the deployed app, used for the judge QR code (e.g. https://plenty.example.com).
PUBLIC_BASE_URL=
